rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 250)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('role' in data) || data.role == null || (data.role is string && data.role.size() <= 100)) &&
             (!('department' in data) || data.department == null || (data.department is string && data.department.size() <= 150)) &&
             (!('institution' in data) || data.institution == null || (data.institution is string && data.institution.size() <= 200)) &&
             (!('transformationScore' in data) || (data.transformationScore is number && data.transformationScore >= 0 && data.transformationScore <= 100)) &&
             (!('sessionsCount' in data) || (data.sessionsCount is number && data.sessionsCount >= 0)) &&
             (!('completedTasksCount' in data) || (data.completedTasksCount is number && data.completedTasksCount >= 0));
    }

    // Client-created profiles must start with trusted baseline metrics.
    function hasInitialProfileMetrics(data) {
      return data.transformationScore == 15 &&
             data.sessionsCount == 0 &&
             data.completedTasksCount == 0;
    }

    // A signed-in user may edit only presentation/profile fields.
    // Identity and server/application-managed metrics cannot be changed by profile edits.
    function onlyProfileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoURL', 'role', 'department', 'institution', 'lastLoginAt', 'updatedAt']);
    }

    function isValidInteraction(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.type is string &&
             data.type in ['copilot', 'meeting_prep', 'email_assistant', 'process_optimizer', 'learning_assistant', 'learning_progress', 'transformation_assessment', 'transformation_plan'] &&
             data.title is string &&
             data.title.size() <= 300 &&
             (!('summary' in data) || data.summary == null || (data.summary is string && data.summary.size() <= 2000));
    }

    function isValidTransformationAssessment(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.overallScore is number &&
             data.overallScore >= 0 &&
             data.overallScore <= 100;
    }

    function isValidTransformationPlan(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.status is string &&
             data.status in ['active', 'completed', 'archived'] &&
             (!('currentWeek' in data) || (data.currentWeek is number && data.currentWeek >= 1 && data.currentWeek <= 4));
    }

    function isValidLearningProgress(data) {
      return data.id is string &&
             data.id.size() <= 128 &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.topicId is string &&
             data.topicId.size() <= 128 &&
             data.status is string &&
             data.status in ['not_started', 'in_progress', 'completed'] &&
             (!('quizScore' in data) || (data.quizScore is number && data.quizScore >= 0 && data.quizScore <= 100));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       hasInitialProfileMetrics(incoming()) &&
                       incoming().uid == userId;
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == userId &&
                       onlyProfileFieldsChanged();
      allow delete: if false;

      match /interactions/{interactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(interactionId) && isValidInteraction(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(interactionId) && isValidInteraction(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(interactionId);
      }

      match /transformationAssessments/{assessmentId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(assessmentId) && isValidTransformationAssessment(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(assessmentId) && isValidTransformationAssessment(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(assessmentId);
      }

      match /transformationPlans/{planId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(planId) && isValidTransformationPlan(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(planId) && isValidTransformationPlan(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(planId);
      }

      match /learningProgress/{topicId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(topicId) && isValidLearningProgress(incoming()) && incoming().userId == userId;
        allow update: if isOwner(userId) && isValidId(topicId) && isValidLearningProgress(incoming()) && incoming().userId == userId;
        allow delete: if isOwner(userId) && isValidId(topicId);
      }
    }

    match /test/{docId} {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
